generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum ConcertStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
}

enum BookingStatus {
  RECEIVED
  WAITING_FOR_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum VoucherType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(CUSTOMER)

  bookings      Booking[]
  voucherUsages VoucherUsage[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Concert {
  id               String           @id @default(uuid())
  name             String
  description      String?
  venue            String
  startAt          DateTime
  status            ConcertStatus    @default(DRAFT)

  ticketCategories TicketCategory[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([startAt])
}

model TicketCategory {
  id                String         @id @default(uuid())
  concertId         String
  name              String
  price             Decimal        @db.Decimal(12, 2)
  totalQuantity     Int
  availableQuantity Int

  concert           Concert        @relation(fields: [concertId], references: [id])
  bookingItems      BookingItem[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([concertId])
}

model Booking {
  id             String         @id @default(uuid())
  userId         String
  voucherId      String?
  idempotencyKey String
  status         BookingStatus  @default(RECEIVED)
  subtotalAmount Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(12, 2)

  user           User           @relation(fields: [userId], references: [id])
  voucher        Voucher?       @relation(fields: [voucherId], references: [id])
  items          BookingItem[]
  voucherUsage   VoucherUsage?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BookingItem {
  id               String         @id @default(uuid())
  bookingId        String
  ticketCategoryId String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)

  booking          Booking        @relation(fields: [bookingId], references: [id])
  ticketCategory   TicketCategory  @relation(fields: [ticketCategoryId], references: [id])

  createdAt        DateTime       @default(now())
}

model Voucher {
  id         String       @id @default(uuid())
  code       String       @unique
  type       VoucherType
  value      Decimal      @db.Decimal(12, 2)
  usageLimit Int
  usedCount  Int          @default(0)
  startsAt   DateTime
  expiresAt  DateTime
  active     Boolean      @default(true)
  minOrderAmount    Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)

  bookings   Booking[]
  usages     VoucherUsage[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model VoucherUsage {
  id        String   @id @default(uuid())
  voucherId String
  userId    String
  bookingId String   @unique

  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([voucherId, userId])
}
